package tests;

use ecosystem::syntax::examples::basic as app;
use ecosystem::syntax;
use std::testing;

#[test]
fn independent_typed_configuration_and_trivia_preserving_rewrite() -> () {
    app::exercise();
}

#[test]
fn parser_preserves_errors_and_recovers_at_lines_and_braces() -> () {
    let source = "outer {\n broken =\n good = 42\n inner {\n name = \"bad\\q\"\n okay = \"中\"\n";
    let parsed = testing::expect_ok(app::parse(source), "parse malformed");
    testing::assert_eq(parsed.root.text(), source);
    testing::assert_eq(parsed.diagnostics.len(), 4);
    let outer = testing::expect_some(app::section(parsed.root, Vec::from_array(["outer"])), "outer");
    testing::assert_eq(app::entries(outer).len(), 1);
    testing::assert_eq(testing::expect_ok(app::entries(outer)[0].integer_value(), "good"), 42);
    let changed = testing::expect_ok(
        app::rewrite(parsed.root, Vec::from_array(["outer", "inner"]), "okay", "\"updated😀\""),
        "recoverable rewrite",
    );
    testing::assert(changed.text().contains("okay = \"updated😀\""));
    testing::assert(changed.text().contains("name = \"bad\\q\""));
    testing::assert_err(app::rewrite(parsed.root, Vec::new(), "missing", "1"));
    testing::assert_err(app::rewrite(parsed.root, Vec::from_array(["outer"]), "good", "1 2"));
    testing::assert_err(
        app::rewrite(parsed.root, Vec::from_array(["outer"]), "good", "\"invalid\\q\""),
    );
    let reparsed = testing::expect_ok(app::parse(changed.text()), "reparse");
    testing::assert_eq(reparsed.diagnostics.len(), 4);
    testing::assert_eq(parsed.root.text(), source);
}

#[test]
fn typed_values_and_parser_depth_fail_recoverably() -> () {
    let parsed = testing::expect_ok(app::parse("name = \"x\"\ncount = 123\n"), "parse");
    let entries = app::entries(parsed.root);
    testing::assert_err(entries[0].integer_value());
    testing::assert_err(entries[1].string_value());
    let mut source = "";
    for _ in 0..129 {
        source += "nested {\n";
    }
    testing::assert_err(app::parse(source));
    let changed = testing::expect_ok(
        app::rewrite(parsed.root, Vec::new(), "count", "-8"),
        "negative integer",
    );
    let root = syntax::SyntaxNode::new_root(changed);
    testing::assert_eq(
        testing::expect_ok(app::entries(root)[1].integer_value(), "negative value"),
        -8,
    );
}

#[test]
fn downstream_text_excerpt_uses_absolute_unicode_ranges() -> () {
    let source = "name = \"😀é\"\n";
    let parsed = testing::expect_ok(app::parse(source), "parse");
    let range = testing::expect_ok(syntax::TextRange::new(8, 14), "range");
    testing::assert_eq(testing::expect_ok(parsed.root.text_slice(range), "excerpt"), "😀é");
}

#[test]
fn downstream_range_tokens_reconstruct_excerpts() -> () {
    let parsed = testing::expect_ok(app::parse("name = \"é\"\n"), "parse");
    let range = testing::expect_ok(syntax::TextRange::new(7, 11), "range");
    let tokens = testing::expect_ok(parsed.root.tokens_in_range(range), "tokens");
    let parts: Vec[string] = Vec::new();
    for token in tokens {
        parts.push(token.text());
    }
    testing::assert_eq(parts.join(""), "\"é\"");
}
